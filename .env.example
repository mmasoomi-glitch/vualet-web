# ============================================================
# Vualet / Mira — environment
# Copy to .env.local for dev, and set these in Vercel → Settings → Environment Variables.
# Nothing here is required to BUILD; they switch features on at runtime.
# ============================================================

# --- App ---
APP_URL=https://mira.vualet.com
NEXT_PUBLIC_APP_URL=https://mira.vualet.com
NEXT_PUBLIC_TELEGRAM_BOT=ballerina_10840_bot

# --- Connect-token security ---
# HMAC key that signs Telegram connect tokens (see src/lib/connect-token.ts).
# REQUIRED in production — without it tokens fall back to a public dev secret.
MIRA_TOKEN_SECRET=
# Shared secret the Telegram bot presents on POST /api/connect (header
# x-mira-bind-secret). Must match MIRA_BIND_SECRET in the engine's .env.
MIRA_BIND_SECRET=

# --- Admin dashboard (server-side gate in src/middleware.ts) ---
# Both are required to enable /admin; unset = admin sign-in disabled (503).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Dodo Payments (money-in: checkout, subscriptions, customer portal) ---
# Create the account + 3 subscription products, then paste ids/keys here.
DODO_PAYMENTS_API_KEY=
DODO_ENVIRONMENT=test_mode            # test_mode | live_mode
DODO_WEBHOOK_SECRET=                  # from the webhook endpoint you add in Dodo
DODO_PRODUCT_COMPANION=               # product id for the $19 plan
DODO_PRODUCT_ASSISTANT=               # product id for the $59 plan
DODO_PRODUCT_STUDIO=                  # product id for the $199 plan

# --- Durable store (subscription state + Telegram connect tokens) ---
# Vercel KV / Upstash Redis. Without these the store falls back to in-memory
# (fine for build/dev, NOT durable in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
