{
  "manifest_version": 3,
  "name": "Mira Help",
  "version": "0.1.0",
  "description": "Ask questions about Mira and Vualet in a side panel and listen to spoken answers.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://mira.vualet.com/api/veridian-demo",
    "https://mira.vualet.com/api/veridian-voice"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Mira Help",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
