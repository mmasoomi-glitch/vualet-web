<Application x:Class="MiraVpn.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="App_Startup"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Rose" Color="#F8A5A0"/>
        <SolidColorBrush x:Key="Lavender" Color="#C7B8F0"/>
        <SolidColorBrush x:Key="Cream" Color="#FFF8F0"/>
        <SolidColorBrush x:Key="Ink" Color="#2A1F2D"/>
        <SolidColorBrush x:Key="Graphite" Color="#524A55"/>
    </Application.Resources>
</Application>
