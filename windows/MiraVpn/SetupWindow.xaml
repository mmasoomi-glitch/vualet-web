<Window x:Class="MiraVpn.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Title="Mira VPN Setup" Height="520" Width="520"
        Background="#FFF8F0" BorderBrush="#F8A5A0" BorderThickness="2">
    <Grid Margin="24">
        <StackPanel>
            <!-- Logo area -->
            <TextBlock Text="Mira VPN" FontFamily="Segoe UI" FontSize="28" FontWeight="SemiBold"
                       Foreground="#2A1F2D" HorizontalAlignment="Center" Margin="0,20,0,4"/>
            <TextBlock x:Name="SubtitleText" Text="Smart, private connection. Built-in network driver."
                       FontFamily="Segoe UI" FontSize="13" Foreground="#524A55"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>

            <!-- Reinstall warning -->
            <Border x:Name="ReinstallWarning" Background="#FFDCE0" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Mira VPN is already installed." FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#2A1F2D" Margin="0,0,0,4"/>
                    <TextBlock Text="This will reinstall the network driver and reset settings." FontFamily="Segoe UI" FontSize="12" Foreground="#524A55" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Install path -->
            <TextBlock Text="Install location" FontWeight="SemiBold" FontSize="13" Foreground="#2A1F2D" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0" Height="32" VerticalAlignment="Center" FontSize="13" Padding="8,4" BorderBrush="#E8E0EA" Background="White"/>
                <Button x:Name="BrowseBtn" Grid.Column="1" Content="Browse..." Width="80" Height="32" Margin="6,0,0,0" Background="#F2EAF0" Foreground="#2A1F2D" BorderBrush="#E8E0EA" Click="BrowseBtn_Click"/>
            </Grid>

            <!-- Auto-start + Auto-connect -->
            <CheckBox x:Name="AutoStartCheck" Content="Start Mira VPN when Windows starts" IsChecked="True" Margin="0,14,0,4" FontFamily="Segoe UI" FontSize="13" Foreground="#2A1F2D"/>
            <CheckBox x:Name="AutoConnectCheck" Content="Auto-connect on startup" IsChecked="False" Margin="0,4,0,16" FontFamily="Segoe UI" FontSize="13" Foreground="#2A1F2D"/>

            <!-- Progress / log -->
            <Grid Margin="0,0,0,0" Height="110">
                <TextBox x:Name="LogBox" Foreground="#F2EAF0" Background="#1A1525" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" BorderThickness="0"/>
                <TextBlock x:Name="LogPlaceholder" Text="Ready to install." Foreground="#8C8190" FontSize="12" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Buttons -->
            <Grid Margin="0,18,0,0">
                <Button x:Name="InstallBtn" Content="Install" HorizontalAlignment="Right" Width="130" Height="40" Click="InstallBtn_Click" FontWeight="SemiBold" FontSize="15" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#F8A5A0" CornerRadius="999" Name="border" Width="130" Height="40">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CancelBtn" Content="Cancel" HorizontalAlignment="Left" Width="100" Height="40" Click="CancelBtn_Click" Background="Transparent" Foreground="#8C8190" BorderBrush="#E8E0EA" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="999" BorderBrush="#E8E0EA" BorderThickness="1" Name="border" Width="100" Height="40">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
